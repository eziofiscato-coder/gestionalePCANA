wd_hash:\\n                        trovato=ut\\n                        \",\"type\":\"DEFAULT\"},{\"content\":\"break\",\"type\":\"KEYWORD\"},{\"content\":\"\\n                \",\"type\":\"DEFAULT\"},{\"content\":\"if\",\"type\":\"KEYWORD\"},{\"content\":\" trovato:\\n                    st.session_state.authenticated=\",\"type\":\"DEFAULT\"},{\"content\":\"True\",\"type\":\"KEYWORD\"},{\"content\":\"\\n                    st.session_state.ruolo=trovato[\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"ruolo\\\"\",\"type\":\"STR\"},{\"content\":\"]\\n                    st.session_state.username=trovato[\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"username\\\"\",\"type\":\"STR\"},{\"content\":\"]\\n                    st.rerun()\\n                \",\"type\":\"DEFAULT\"},{\"content\":\"else\",\"type\":\"KEYWORD\"},{\"content\":\":\\n                    st.error(\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Username o password errati\\\"\",\"type\":\"STR\"},{\"content\":\")\\n    st.stop()\\n\\nheader_loghi()\\nst.divider()\\n\\n\",\"type\":\"DEFAULT\"},{\"content\":\"with\",\"type\":\"KEYWORD\"},{\"content\":\" st.sidebar:\\n    \",\"type\":\"DEFAULT\"},{\"content\":\"if\",\"type\":\"KEYWORD\"},{\"content\":\" os.path.exists(\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"logo.png\\\"\",\"type\":\"STR\"},{\"content\":\"):\\n        st.image(\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"logo.png\\\"\",\"type\":\"STR\"},{\"content\":\",width=\",\"type\":\"DEFAULT\"},{\"content\":\"80\",\"type\":\"NUMBER\"},{\"content\":\")\\n    st.markdown(\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Ciao \\\"\",\"type\":\"STR\"},{\"content\":\"+st.session_state.username+\",\"type\":\"DEFAULT\"},{\"content\":\"\\\" | \\\"\",\"type\":\"STR\"},{\"content\":\"+st.session_state.ruolo)\\n    opzioni=[\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Dashboard\\\"\",\"type\":\"STR\"},{\"content\":\",\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Volontari\\\"\",\"type\":\"STR\"},{\"content\":\",\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Mappa Postazioni\\\"\",\"type\":\"STR\"},{\"content\":\",\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Eventi\\\"\",\"type\":\"STR\"},{\"content\":\",\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"DB Radio\\\"\",\"type\":\"STR\"},{\"content\":\",\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Check-In\\\"\",\"type\":\"STR\"},{\"content\":\",\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Brogliaccio\\\"\",\"type\":\"STR\"},{\"content\":\",\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Consegna Radio\\\"\",\"type\":\"STR\"},{\"content\":\",\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Emergenze\\\"\",\"type\":\"STR\"},{\"content\":\",\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Backup\\\"\",\"type\":\"STR\"},{\"content\":\"]\\n    sel=st.radio(\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Vai a\\\"\",\"type\":\"STR\"},{\"content\":\",opzioni,index=\",\"type\":\"DEFAULT\"},{\"content\":\"0\",\"type\":\"NUMBER\"},{\"content\":\")\\n    \",\"type\":\"DEFAULT\"},{\"content\":\"if\",\"type\":\"KEYWORD\"},{\"content\":\" sel!=st.session_state.menu_scelta:\\n        st.session_state.menu_scelta=sel\\n        st.rerun()\\n    \",\"type\":\"DEFAULT\"},{\"content\":\"if\",\"type\":\"KEYWORD\"},{\"content\":\" st.button(\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"LOGOUT\\\"\",\"type\":\"STR\"},{\"content\":\",use_container_width=\",\"type\":\"DEFAULT\"},{\"content\":\"True\",\"type\":\"KEYWORD\"},{\"content\":\"):\\n        st.session_state.authenticated=\",\"type\":\"DEFAULT\"},{\"content\":\"False\",\"type\":\"KEYWORD\"},{\"content\":\"\\n        st.rerun()\\n\\nscelta=st.session_state.menu_scelta\\n\\n\",\"type\":\"DEFAULT\"},{\"content\":\"if\",\"type\":\"KEYWORD\"},{\"content\":\" scelta==\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Dashboard\\\"\",\"type\":\"STR\"},{\"content\":\":\\n    st.markdown(\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"## DASHBOARD\\\"\",\"type\":\"STR\"},{\"content\":\")\\n    c1,c2=st.columns([3,1])\\n    with c1:\\n        st.success(\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Benvenuto \\\"\",\"type\":\"STR\"},{\"content\":\"+st.session_state.username+\",\"type\":\"DEFAULT\"},{\"content\":\"\\\" | Ruolo: \\\"\",\"type\":\"STR\"},{\"content\":\"+st.session_state.ruolo)\\n    with c2:\\n        if st.button(\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"LOGOUT\\\"\",\"type\":\"STR\"},{\"content\":\",use_container_width=True,type=\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"primary\\\"\",\"type\":\"STR\"},{\"content\":\",key=\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"logout_dash\\\"\",\"type\":\"STR\"},{\"content\":\"):\\n            st.session_state.authenticated=False\\n            st.rerun()\\n    st.divider()\\n    st.markdown(\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"### MENU RAPIDO - TASTI\\\"\",\"type\":\"STR\"},{\"content\":\")\\n    r1c1, r1c2, r1c3, r1c4 = st.columns(\",\"type\":\"DEFAULT\"},{\"content\":\"4\",\"type\":\"NUMBER\"},{\"content\":\")\\n    \",\"type\":\"DEFAULT\"},{\"content\":\"with\",\"type\":\"KEYWORD\"},{\"content\":\" r1c1:\\n        \",\"type\":\"DEFAULT\"},{\"content\":\"if\",\"type\":\"KEYWORD\"},{\"content\":\" st.button(\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"VOLONTARI\\\"\",\"type\":\"STR\"},{\"content\":\", use_container_width=\",\"type\":\"DEFAULT\"},{\"content\":\"True\",\"type\":\"KEYWORD\"},{\"content\":\", key=\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"rap_vol\\\"\",\"type\":\"STR\"},{\"content\":\"):\\n            st.session_state.menu_scelta=\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Volontari\\\"\",\"type\":\"STR\"},{\"content\":\"\\n            st.rerun()\\n    \",\"type\":\"DEFAULT\"},{\"content\":\"with\",\"type\":\"KEYWORD\"},{\"content\":\" r1c2:\\n        \",\"type\":\"DEFAULT\"},{\"content\":\"if\",\"type\":\"KEYWORD\"},{\"content\":\" st.button(\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"MAPPA POSTAZIONI\\\"\",\"type\":\"STR\"},{\"content\":\", use_container_width=\",\"type\":\"DEFAULT\"},{\"content\":\"True\",\"type\":\"KEYWORD\"},{\"content\":\",