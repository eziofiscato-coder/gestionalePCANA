nt\":\"from\"},{\"content\":\" io \"},{\"content\":\"import\"},{\"content\":\" BytesIO\\n\"},{\"content\":\"import\"},{\"content\":\" os, json, base64, hashlib, requests\\n\\nst.set_page_config(page_title=\"},{\"content\":\"\\\"ANA Varese\\\"\"},{\"content\":\", page_icon=\"},{\"content\":\"\\\"🟢\\\"\"},{\"content\":\", layout=\"},{\"content\":\"\\\"wide\\\"\"},{\"content\":\")\\n\\nst.markdown(\"},{\"content\":\"$a5\"},{\"content\":\", unsafe_allow_html=\"},{\"content\":\"True\"},{\"content\":\")\\n\\n\"},{\"content\":\"def\"},{\"content\":\" \"},{\"content\":\"load_json\"},{\"content\":\"(f, default):\\n    \"},{\"content\":\"try\"},{\"content\":\":\\n        \"},{\"content\":\"if\"},{\"content\":\" os.path.exists(f):\\n            \"},{\"content\":\"with\"},{\"content\":\" open(f,\"},{\"content\":\"\\\"r\\\"\"},{\"content\":\",encoding=\"},{\"content\":\"\\\"utf-8\\\"\"},{\"content\":\") \"},{\"content\":\"as\"},{\"content\":\" fh:\\n                \"},{\"content\":\"return\"},{\"content\":\" json.load(fh)\\n    \"},{\"content\":\"except\"},{\"content\":\":\\n        \"},{\"content\":\"pass\"},{\"content\":\"\\n    \"},{\"content\":\"return\"},{\"content\":\" default\\n\\n\"},{\"content\":\"def\"},{\"content\":\" \"},{\"content\":\"save_json\"},{\"content\":\"(f,d):\\n    \"},{\"content\":\"try\"},{\"content\":\":\\n        \"},{\"content\":\"with\"},{\"content\":\" open(f,\"},{\"content\":\"\\\"w\\\"\"},{\"content\":\",encoding=\"},{\"content\":\"\\\"utf-8\\\"\"},{\"content\":\") \"},{\"content\":\"as\"},{\"content\":\" fh:\\n            json.dump(d,fh,ensure_ascii=\"},{\"content\":\"False\"},{\"content\":\",indent=\"},{\"content\":\"2\"},{\"content\":\")\\n    \"},{\"content\":\"except\"},{\"content\":\":\\n        \"},{\"content\":\"pass\"},{\"content\":\"\\n\\n\"},{\"content\":\"def\"},{\"content\":\" \"},{\"content\":\"get_b64\"},{\"content\":\"(p):\\n    \"},{\"content\":\"try\"},{\"content\":\":\\n        \"},{\"content\":\"if\"},{\"content\":\" os.path.e