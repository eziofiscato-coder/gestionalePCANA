"eventi.json\\\"\",\"type\":\"STR\"},{\"content\":\"\\nFILE_RADIO=\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"db_radio.json\\\"\",\"type\":\"STR\"},{\"content\":\"\\nFILE_CHECKIN=\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"checkin.json\\\"\",\"type\":\"STR\"},{\"content\":\"\\nFILE_BROGLIACCIO=\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"brogliaccio.json\\\"\",\"type\":\"STR\"},{\"content\":\"\\nFILE_CONSEGNA=\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"consegna_radio.json\\\"\",\"type\":\"STR\"},{\"content\":\"\\nFILE_EMERGENZE=\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"emergenze.json\\\"\",\"type\":\"STR\"},{\"content\":\"\\nCOMUNI=[\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Varese\\\"\",\"type\":\"STR\"},{\"content\":\",\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Busto Arsizio\\\"\",\"type\":\"STR\"},{\"content\":\",\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Gallarate\\\"\",\"type\":\"STR\"},{\"content\":\",\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Saronno\\\"\",\"type\":\"STR\"},{\"content\":\",\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Venegono Superiore\\\"\",\"type\":\"STR\"},{\"content\":\",\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Venegono Inferiore\\\"\",\"type\":\"STR\"},{\"content\":\",\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Castiglione Olona\\\"\",\"type\":\"STR\"},{\"content\":\",\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Lozza\\\"\",\"type\":\"STR\"},{\"content\":\",\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Tradate\\\"\",\"type\":\"STR\"},{\"content\":\",\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Malnate\\\"\",\"type\":\"STR\"},{\"content\":\",\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Luino\\\"\",\"type\":\"STR\"},{\"content\":\",\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"Altro\\\"\",\"type\":\"STR\"},{\"content\":\"]\\n\\nfor k,v in [(\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"dati\\\"\",\"type\":\"STR\"},{\"content\":\",[]),(\",\"type\":\"DEFAULT\"},{\"content\":\"\\\"postazioni\\\"\",\"type\":\"STR\"},{\"content\":\",[]),(\",\"typ